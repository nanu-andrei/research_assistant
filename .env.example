# LLM Configuration
# LiteLLM format: e.g. "gemini/gemini-2.0-flash", "openai/gpt-4o-mini", "anthropic/claude-3-5-sonnet-20241022", "ollama/llama3"
LLM_MODEL=gemini/gemini-2.0-flash

# API Keys (set the one corresponding to your model)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Semantic Scholar API Key (Optional - rate limit is 1 req/sec without key)
SEMANTIC_SCHOLAR_API_KEY=
